<mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- TITLE -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="title" value="Visual Servoing Pipeline — servo_lastmile_v2_ext.py" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="400" y="20" width="1000" height="40" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- INPUTS -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="grp_inputs" value="Inputs" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="200" height="280" as="geometry" />
    </mxCell>
    <mxCell id="ref_image" value="Reference Image&#xa;(--ref-image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp_inputs">
      <mxGeometry x="20" y="40" width="160" height="50" as="geometry" />
    </mxCell>
    <mxCell id="zed_cam" value="ZED Mini Camera&#xa;(HD720 · 30fps · stereo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp_inputs">
      <mxGeometry x="20" y="110" width="160" height="50" as="geometry" />
    </mxCell>
    <mxCell id="robot_hw" value="xArm 6&#xa;(TCP · 192.168.1.241)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp_inputs">
      <mxGeometry x="20" y="180" width="160" height="50" as="geometry" />
    </mxCell>
    <mxCell id="gt_pose" value="GT Pose JSON&#xa;(record_grasp_point.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp_inputs">
      <mxGeometry x="20" y="210" width="160" height="50" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- STARTUP SEQUENCE -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="grp_startup" value="Startup (once)" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="280" y="80" width="220" height="280" as="geometry" />
    </mxCell>
    <mxCell id="robot_connect" value="1. Robot connects&#xa;Record home position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="grp_startup">
      <mxGeometry x="20" y="35" width="180" height="45" as="geometry" />
    </mxCell>
    <mxCell id="model_load" value="2. Load models (GPU)&#xa;SAM3 · DINOv2 · CoTracker3 · SAM2&#xa;GroundingDINO (if gdino)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="grp_startup">
      <mxGeometry x="20" y="90" width="180" height="55" as="geometry" />
    </mxCell>
    <mxCell id="zed_open" value="3. ZED opens&#xa;Pull intrinsics · start depth stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="grp_startup">
      <mxGeometry x="20" y="155" width="180" height="45" as="geometry" />
    </mxCell>
    <mxCell id="jyz_cal" value="4. Y/Z Jacobian Calibration (thread)&#xa;Probe ±25mm Y · probe ±25mm Z&#xa;Compute J_yz (px/mm) → enable servo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="grp_startup">
      <mxGeometry x="20" y="210" width="180" height="55" as="geometry" />
    </mxCell>

    <!-- startup arrows -->
    <mxCell id="a_rc_ml" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="robot_connect" target="model_load" parent="grp_startup">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_ml_zo" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="model_load" target="zed_open" parent="grp_startup">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_zo_jyz" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="zed_open" target="jyz_cal" parent="grp_startup">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- DETECTION BACKEND -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="grp_det" value="Detection Backend  (--detector)" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="540" y="80" width="230" height="200" as="geometry" />
    </mxCell>
    <mxCell id="det_sam3" value="SAM3&#xa;(default)&#xa;Detect + Segment in one pass&#xa;→ mask + centroid + score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="grp_det">
      <mxGeometry x="15" y="35" width="200" height="50" as="geometry" />
    </mxCell>
    <mxCell id="det_gdino" value="GroundingDINO only&#xa;BBox centroid · no mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="grp_det">
      <mxGeometry x="15" y="100" width="200" height="40" as="geometry" />
    </mxCell>
    <mxCell id="det_gsam2" value="GroundingDINO + SAM2&#xa;BBox → SAM2 mask + centroid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="grp_det">
      <mxGeometry x="15" y="150" width="200" height="40" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- STATE MACHINE -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="grp_fsm" value="State Machine" style="swimlane;startSize=25;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="540" y="320" width="800" height="380" as="geometry" />
    </mxCell>

    <!-- FAR state -->
    <mxCell id="state_far" value="FAR&#xa;─────────────────&#xa;• Run detector each frame&#xa;• Check area fraction 5–25%&#xa;• ZED depth gate (valid &amp; &lt;5000mm)&#xa;• 3 consecutive frames → lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="grp_fsm">
      <mxGeometry x="20" y="40" width="210" height="120" as="geometry" />
    </mxCell>

    <!-- lock -->
    <mxCell id="lock_state" value="LOCK&#xa;(LockState)&#xa;centroid_px · centroid_base&#xa;depth_mm · K · T_ee_cam" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="grp_fsm">
      <mxGeometry x="255" y="40" width="170" height="80" as="geometry" />
    </mxCell>

    <!-- NEAR-SAM3 state -->
    <mxCell id="state_near_sam3" value="NEAR — sam3 phase&#xa;─────────────────&#xa;• SAM3 only (no fusion)&#xa;• EMA on centroid&#xa;• Surface normal → tilt/roll/pitch&#xa;• Buffer last 5 SAM3 centroids&#xa;• Exit: box touches frame border" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="grp_fsm">
      <mxGeometry x="450" y="30" width="210" height="130" as="geometry" />
    </mxCell>

    <!-- NEAR-TRACK state -->
    <mxCell id="state_near_track" value="NEAR — track phase&#xa;─────────────────&#xa;• Signal B (CoTracker3) primary&#xa;• Signal D (DINOv2 best-buddy)&#xa;• Signal A (locked-3D reproject)&#xa;• Signal E (SAM3 re-anchor / 5fr)&#xa;• Watchdog: SAM2 (Signal C)&#xa;• Weighted geometric median fusion&#xa;• EE occlusion mask on Signal D&#xa;• Surface normal every frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="grp_fsm">
      <mxGeometry x="450" y="190" width="210" height="175" as="geometry" />
    </mxCell>

    <!-- TERMINAL state -->
    <mxCell id="state_term" value="TERMINAL&#xa;─────────────────&#xa;• depth &lt; 30mm&#xa;  OR robot X &gt; 505mm&#xa;• No lateral correction&#xa;• Final plane-fit normal reported&#xa;• Operator plunges manually" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="grp_fsm">
      <mxGeometry x="685" y="100" width="100" height="150" as="geometry" />
    </mxCell>

    <!-- FSM transitions -->
    <mxCell id="a_far_lock" value="3 consec frames" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="state_far" target="lock_state" parent="grp_fsm">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_lock_ns" value="enter NEAR" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="lock_state" target="state_near_sam3" parent="grp_fsm">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_ns_nt" value="box exits frame" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="state_near_sam3" target="state_near_track" parent="grp_fsm">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_nt_term" value="depth&lt;30mm&#xa;or X&gt;505mm" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="state_near_track" target="state_term" parent="grp_fsm">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_ns_term" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="state_near_sam3" target="state_term" parent="grp_fsm">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SIGNALS BOX -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="grp_signals" value="Signals (NEAR-track phase)" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="540" y="740" width="800" height="200" as="geometry" />
    </mxCell>
    <mxCell id="sig_a" value="Signal A&#xa;Locked-3D reproject&#xa;T_ee_cam · hand-eye cal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="grp_signals">
      <mxGeometry x="10" y="35" width="140" height="60" as="geometry" />
    </mxCell>
    <mxCell id="sig_b" value="Signal B&#xa;CoTracker3&#xa;optical flow tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="grp_signals">
      <mxGeometry x="160" y="35" width="140" height="60" as="geometry" />
    </mxCell>
    <mxCell id="sig_c" value="Signal C&#xa;SAM2 watchdog&#xa;(not fused — alarm only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="grp_signals">
      <mxGeometry x="310" y="35" width="140" height="60" as="geometry" />
    </mxCell>
    <mxCell id="sig_d" value="Signal D&#xa;DINOv2 best-buddy&#xa;+ EE occlusion mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="grp_signals">
      <mxGeometry x="460" y="35" width="140" height="60" as="geometry" />
    </mxCell>
    <mxCell id="sig_e" value="Signal E&#xa;SAM3 re-anchor&#xa;every 5 NEAR frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="grp_signals">
      <mxGeometry x="610" y="35" width="140" height="60" as="geometry" />
    </mxCell>
    <mxCell id="fusion" value="Weighted Geometric Median&#xa;A + B + D + E → best_centroid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="grp_signals">
      <mxGeometry x="210" y="130" width="370" height="50" as="geometry" />
    </mxCell>
    <mxCell id="a_sa_fus" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="sig_a" target="fusion" parent="grp_signals">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_sb_fus" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="sig_b" target="fusion" parent="grp_signals">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_sd_fus" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="sig_d" target="fusion" parent="grp_signals">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_se_fus" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="sig_e" target="fusion" parent="grp_signals">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CONTROL LAW -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="grp_ctrl" value="Control Law  (per servo step, ≥0.3s apart)" style="swimlane;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1380" y="320" width="480" height="380" as="geometry" />
    </mxCell>
    <mxCell id="ctrl_tilt" value="① Tilt Correction (NEAR only)&#xa;─────────────────────────&#xa;Gate: tilt &gt; 1° AND inliers ≥ 500&#xa;Δroll  = clamp(−0.6 × roll_deg,  ±3°)&#xa;Δpitch = clamp(−0.6 × pitch_deg, ±3°)&#xa;→ arm.set_tool_position(relative=True)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="grp_ctrl">
      <mxGeometry x="20" y="35" width="440" height="90" as="geometry" />
    </mxCell>
    <mxCell id="ctrl_xy" value="② XY Centering&#xa;─────────────────────────&#xa;error (ex, ey) = best_centroid − image_centre&#xa;Dead-zone: |e| &lt; 8px → skip&#xa;Jump guard: |Δcentroid| &gt; 80px → skip&#xa;(dy, dz) = J_yz_inv @ (ex, ey), clamped ±12mm&#xa;→ arm.set_position(y+=dy, z+=dz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="grp_ctrl">
      <mxGeometry x="20" y="140" width="440" height="100" as="geometry" />
    </mxCell>
    <mxCell id="ctrl_x" value="③ Approach (every step)&#xa;─────────────────────────&#xa;x += +5mm  at 150mm/s&#xa;Safety: MIN_Z_MM = −300mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="grp_ctrl">
      <mxGeometry x="20" y="255" width="440" height="75" as="geometry" />
    </mxCell>
    <mxCell id="ctrl_watch" value="④ Watchdog&#xa;SAM2 centroid vs fused &gt; 60px for 5 frames → servo PAUSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="grp_ctrl">
      <mxGeometry x="20" y="340" width="440" height="30" as="geometry" />
    </mxCell>
    <mxCell id="a_tilt_xy" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ctrl_tilt" target="ctrl_xy" parent="grp_ctrl">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_xy_x" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ctrl_xy" target="ctrl_x" parent="grp_ctrl">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OUTPUTS -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="grp_out" value="Outputs" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1380" y="740" width="480" height="200" as="geometry" />
    </mxCell>
    <mxCell id="out_jsonl" value="frames.jsonl&#xa;state · best_centroid · z_mm&#xa;tilt_deg · roll_deg · pitch_deg&#xa;c_A/B/C/D/E · robot_pos · ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="grp_out">
      <mxGeometry x="10" y="35" width="210" height="70" as="geometry" />
    </mxCell>
    <mxCell id="out_video" value="overlay.mp4 + raw.mp4&#xa;Annotated preview video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="grp_out">
      <mxGeometry x="10" y="120" width="210" height="50" as="geometry" />
    </mxCell>
    <mxCell id="out_analysis" value="analysis/ (post-run)&#xa;error_over_distance.png&#xa;tilt_timeline.png · summary.json&#xa;lateral_err · success flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="grp_out">
      <mxGeometry x="255" y="35" width="210" height="135" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SURFACE NORMAL BLOCK -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="surf_norm" value="Surface Normal (every NEAR frame)&#xa;ZED depth patch → RANSAC plane fit&#xa;→ tilt_deg · roll_deg · pitch_deg&#xa;→ feeds Tilt Correction + logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="1380" y="80" width="280" height="90" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CROSS-GROUP ARROWS -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- inputs → startup -->
    <mxCell id="a_in_su" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ref_image" target="grp_startup" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_zed_su" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="zed_cam" target="grp_startup" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a_rob_su" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="robot_hw" target="grp_startup" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- startup → detection -->
    <mxCell id="a_su_det" value="ref image + prompt" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="grp_startup" target="grp_det" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- detection → FAR state -->
    <mxCell id="a_det_far" value="runner(frame)" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="grp_det" target="state_far" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ZED → state machine (depth + frames) -->
    <mxCell id="a_zed_fsm" value="RGB + depth" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="zed_cam" target="grp_fsm" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- NEAR-track → signals -->
    <mxCell id="a_nt_sigs" value="frame + lock" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="state_near_track" target="grp_signals" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- surface normal → ctrl -->
    <mxCell id="a_sn_ctrl" value="roll/pitch/tilt&#xa;n_inliers" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="surf_norm" target="ctrl_tilt" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- NEAR states → surface normal -->
    <mxCell id="a_ns_sn" value="depth patch" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="state_near_sam3" target="surf_norm" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- fusion → control law -->
    <mxCell id="a_fus_ctrl" value="best_centroid" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="fusion" target="ctrl_xy" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- SAM3 phase → control -->
    <mxCell id="a_ns_ctrl" value="centroid (SAM3)" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="state_near_sam3" target="ctrl_xy" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ctrl → robot -->
    <mxCell id="a_ctrl_rob" value="set_position() / set_tool_position()" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="grp_ctrl" target="robot_hw" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- frame loop → outputs -->
    <mxCell id="a_fsm_jsonl" value="per-frame log" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="grp_fsm" target="out_jsonl" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- gt_pose → analysis -->
    <mxCell id="a_gt_ana" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="gt_pose" target="out_analysis" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- jsonl → analysis -->
    <mxCell id="a_jl_ana" value="analyze_run.py" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="out_jsonl" target="out_analysis" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- LEGEND -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <mxCell id="legend" value="Legend" style="swimlane;startSize=20;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="700" width="460" height="130" as="geometry" />
    </mxCell>
    <mxCell id="l1" value="Startup (one-time)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend">
      <mxGeometry x="10" y="30" width="160" height="25" as="geometry" />
    </mxCell>
    <mxCell id="l2" value="State machine state" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend">
      <mxGeometry x="10" y="65" width="160" height="25" as="geometry" />
    </mxCell>
    <mxCell id="l3" value="Signals (fused)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="legend">
